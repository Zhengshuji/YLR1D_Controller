<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro"
       name="ylr1d">

  <!-- ============================================ -->
  <!-- YAML config values (links.yaml, colors.yaml,  -->
  <!-- limits.yaml, scale.yaml) are passed via xacro -->
  <!-- mappings from the launch file at runtime.     -->
  <!-- ============================================ -->

  <xacro:macro name="ylr1d" params="prefix">
  <link name="${prefix}Link_Base">
    <inertial>
      <origin xyz="0.037265 0.00025041 0.20252" rpy="0 0 0"/>
      <mass value="${links.Link_Base.mass}"/>
      <inertia ixx="${links.Link_Base.inertia.ixx}" ixy="${links.Link_Base.inertia.ixy}" ixz="${links.Link_Base.inertia.ixz}" iyy="${links.Link_Base.inertia.iyy}" iyz="${links.Link_Base.inertia.iyz}" izz="${links.Link_Base.inertia.izz}"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://ylr1d_description/meshes/Link_Base.STL"/>
      </geometry>
      <material name="Base">
        <color rgba="${colors.Link_Base}"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://ylr1d_description/meshes/Link_Base.STL"/>
      </geometry>
    </collision>
  </link>
