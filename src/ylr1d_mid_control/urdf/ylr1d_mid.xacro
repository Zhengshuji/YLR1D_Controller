    <gazebo reference="${prefix}Link_GlobalCameraSensor">
    <sensor type="camera" name="rgb_camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <topic>/global_camera/rgb/image_raw</topic>
      <frame_name>${prefix}Link_GlobalCameraSensor</frame_name>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>1920</width>
          <height>1080</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100.0</far>
        </clip>
      </camera>
      <plugin name="global_camera_rgb_camera_plugin" filename="libgazebo_ros_camera.so">
        <camera_name>global_camera/rgb</camera_name>
        <cameraName>global_camera/rgb</cameraName>
        <image_topic_name>image_raw</image_topic_name>
        <imageTopicName>image_raw</imageTopicName>
        <camera_info_topic_name>camera_info</camera_info_topic_name>
        <cameraInfoTopicName>camera_info</cameraInfoTopicName>
        <frame_name>${prefix}Link_GlobalCameraSensor</frame_name>
        <frameName>${prefix}Link_GlobalCameraSensor</frameName>
      </plugin>
    </sensor>
    <sensor type="depth" name="depth_camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <topic>/global_camera/depth/image_raw</topic>
      <frame_name>${prefix}Link_GlobalCameraSensor</frame_name>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.2</near>
          <far>4.0</far>
        </clip>
      </camera>
      <plugin name="global_camera_depth_camera_plugin" filename="libgazebo_ros_camera.so">
        <camera_name>global_camera/depth</camera_name>
        <cameraName>global_camera/depth</cameraName>
        <image_topic_name>image_raw</image_topic_name>
        <imageTopicName>image_raw</imageTopicName>
        <camera_info_topic_name>camera_info</camera_info_topic_name>
        <cameraInfoTopicName>camera_info</cameraInfoTopicName>
        <point_cloud_topic_name>points</point_cloud_topic_name>
        <pointCloudTopicName>points</pointCloudTopicName>
        <frame_name>${prefix}Link_GlobalCameraSensor</frame_name>
        <frameName>${prefix}Link_GlobalCameraSensor</frameName>
      </plugin>
    </sensor>
    <sensor type="camera" name="infrared_camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <topic>/global_camera/infrared/image_raw</topic>
      <frame_name>${prefix}Link_GlobalCameraSensor</frame_name>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>
      <plugin name="global_camera_infrared_camera_plugin" filename="libgazebo_ros_camera.so">
        <camera_name>global_camera/infrared</camera_name>
        <cameraName>global_camera/infrared</cameraName>
        <image_topic_name>image_raw</image_topic_name>
        <imageTopicName>image_raw</imageTopicName>
        <camera_info_topic_name>camera_info</camera_info_topic_name>
        <cameraInfoTopicName>camera_info</cameraInfoTopicName>
        <frame_name>${prefix}Link_GlobalCameraSensor</frame_name>
        <frameName>${prefix}Link_GlobalCameraSensor</frameName>
      </plugin>
    </sensor>
  </gazebo>
