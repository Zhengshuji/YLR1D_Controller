          </horizontal>
        </scan>
        <range>
          <min>0.25</min>
          <max>4.5</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="lf_ultrasonic_lf_ultrasonic_sensor_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=/lf_ultrasonic/range</remapping>
