  </gazebo>
  <gazebo reference="${prefix}Link_RadarSensor">
    <sensor type="ray" name="radar_sensor">
      <always_on>true</always_on>
      <update_rate>12</update_rate>
      <topic>/radar/scan</topic>
      <frame_name>${prefix}Link_RadarSensor</frame_name>
      <ray>
        <scan>
          <horizontal>
            <samples>2770</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <noise type="gaussian">
        <mean>0.0</mean>
        <stddev>0.01</stddev>
      </noise>
      <plugin name="radar_radar_sensor_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=/radar/scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo reference="${prefix}Link_IMUSensor">
    <sensor type="imu" name="imu_sensor">
      <always_on>true</always_on>
      <update_rate>116</update_rate>
      <topic>/imu_data</topic>
      <frame_name>${prefix}Link_IMUSensor</frame_name>
      <noise type="gaussian">
