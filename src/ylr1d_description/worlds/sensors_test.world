<?xml version="1.0" ?>
<!-- Sensor test world: robot spawns at (0, 0, 0.3).
     Obstacles are placed 0.5~3 m around the robot so that the cameras
     (depth clip far=4.0), radar (30 m) and ultrasonic (4.5 m) all
     have something to sense. -->
<sdf version="1.6">
  <world name="sensors_test">
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Red box, front -->
    <model name="box_red">
      <pose>1.2 0 0.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 1.0</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Blue box, left-front -->
    <model name="box_blue">
      <pose>-1.5 0.3 0.3 0 0 0.2</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.6</size></box></geometry>
          <material><ambient>0.1 0.2 0.8 1</ambient><diffuse>0.1 0.2 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Green cylinder, right -->
    <model name="cyl_green">
      <pose>0 1.0 0.45 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>0.9</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.9</length></cylinder></geometry>
          <material><ambient>0.1 0.8 0.2 1</ambient><diffuse>0.1 0.8 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Yellow sphere, left -->
    <model name="sphere_yellow">
      <pose>0 -1.0 0.35 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><sphere><radius>0.35</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.35</radius></sphere></geometry>
          <material><ambient>0.8 0.8 0.1 1</ambient><diffuse>0.8 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- White wall, far front-right -->
    <model name="wall_white">
      <pose>2.5 0.5 0.4 0 0 0.15</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.5 0.15 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 0.15 0.8</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Orange small cylinder, back-left -->
    <model name="cyl_orange">
      <pose>0.8 -1.4 0.25 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.18</radius><length>0.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.18</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.9 0.5 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Gray low box, back -->
    <model name="box_gray">
      <pose>-1.0 -1.2 0.175 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.6 0.35</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 0.35</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Purple sphere, front-right -->
    <model name="sphere_purple">
      <pose>1.6 1.2 0.25 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><sphere><radius>0.25</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.25</radius></sphere></geometry>
          <material><ambient>0.55 0.15 0.75 1</ambient><diffuse>0.55 0.15 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
