<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ylr1d_bringup</name>
  <version>0.0.0</version>
  <description>
    One-shot bringup for the YLR1D simulation stack: aggregates the
    physical layer (Gazebo), control layer (soft simulation) and HMI
    launch files into a single ros2 launch entry point.
  </description>
  <maintainer email="2607430020@qq.com">zsj</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ylr1d_plant</exec_depend>
  <exec_depend>ylr1d_control_sim</exec_depend>
  <exec_depend>ylr1d_translate</exec_depend>
  <exec_depend>ylr1d_hmi</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
